{
  "name": "github-release-notification-api",
  "version": "1.0.0",
  "description": "API for subscribing to GitHub repository release notifications",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-docker-tests.js unit",
    "test:integration": "node scripts/run-docker-tests.js integration",
    "test:e2e": "node scripts/run-docker-tests.js e2e",
    "test:unit:container": "jest --config jest.unit.config.js --runInBand",
    "test:integration:container": "jest --config jest.integration.config.js --runInBand",
    "test:e2e:container": "playwright test",
    "test:watch": "jest --config jest.unit.config.js --watch",
    "test:coverage": "jest --config jest.unit.config.js --coverage",
    "mocks:container": "tsx tests/mocks/server.ts",
    "lint": "biome check . && npm run lint:boundaries",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "boundaries:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot > docs/architecture/deps.dot",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "bench": "tsx scripts/bench/run.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@prisma/client": "^5.22.0",
    "amqplib": "^0.10.9",
    "bullmq": "^5.28.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.60.0",
    "@types/amqplib": "^0.10.8",
    "@types/autocannon": "^7.12.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "dependency-cruiser": "^17.4.3",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
